APP_ENV=development
DATABASE_URL=sqlite:///./support_agent.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEMO_REVIEWER_TOKEN=local-reviewer-token-change-me
MOCK_SHIPPING_FAIL=0
MOCK_SHIPPING_DELAY_MS=0
MOCK_TICKETING_FAIL=0
MOCK_TICKETING_DELAY_MS=0
MOCK_PAYMENT_FAIL=0
MOCK_PAYMENT_DELAY_MS=0
MOCK_PAYMENT_TIMEOUT_AFTER_ACCEPT=0
MOCK_TICKETING_TIMEOUT_AFTER_ACCEPT=0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
